#!/bin/bash
# repo2docker sources this before starting the notebook server, with the command to run as "$@".
#
# Its job: get the simulator running so a student's first cell works, then hand off. On Binder
# the simulator cannot be a second terminal — there is only one container and one process tree —
# so it runs here, in the background, for the life of the session.
#
# Deliberately NOT `set -e`. If the simulator fails to start, the notebook server must still
# come up: a live session whose first cell reports "SimulatorNotRunning" is recoverable and
# explains itself, whereas a container that refuses to start is a blank stare.

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# A fixed token, unlike the local path where one is generated per run. There is no terminal here
# for anyone to read a banner from, and each Binder session is a private throwaway container, so
# a known value costs nothing and removes a step. Exported so maprt_workshop.connect() finds it
# without touching the filesystem — which also sidesteps a race, since the notebook server may
# start before the simulator has written .maprt_sim/server.json.
export MAPRT_SIM_TOKEN="${MAPRT_SIM_TOKEN:-workshop-binder-token}"
export MAPRT_SIM_URL="http://127.0.0.1:8000"

if ! command -v maprt-sim > /dev/null 2>&1; then
    echo "start: maprt-sim is not installed — did postBuild run?" >&2
else
    # --map-seconds 1: the local default of 3 exists so students can watch a response stream in.
    # On shared Binder hardware that mostly reads as lag, so it is trimmed rather than removed.
    nohup maprt-sim \
        --host 127.0.0.1 \
        --port 8000 \
        --token "$MAPRT_SIM_TOKEN" \
        --data-dir "$REPO_DIR/data/MapRT" \
        --state-dir "$REPO_DIR/.maprt_sim" \
        --map-seconds 1 \
        > "$REPO_DIR/maprt-sim.log" 2>&1 &

    # Wait for it, and say plainly in the log whether it worked. The failure this catches is a
    # silent one: if the port is busy or the data directory is wrong, nohup returns happily and
    # the first notebook cell reports something confusing — during a local test of this script a
    # leftover server on port 8000 answered instead, and the student-facing error was
    # "InvalidClientToken", which points nowhere near the actual problem.
    for _ in $(seq 1 60); do
        if curl -sf -o /dev/null "$MAPRT_SIM_URL/sim/state" 2>/dev/null; then
            echo "start: simulator is up on $MAPRT_SIM_URL"
            break
        fi
        sleep 0.5
    done

    if ! curl -sf -o /dev/null "$MAPRT_SIM_URL/sim/state" 2>/dev/null; then
        echo "start: WARNING — the simulator did not come up. See maprt-sim.log." >&2
        tail -5 "$REPO_DIR/maprt-sim.log" >&2 2>/dev/null
    fi
fi

exec "$@"
