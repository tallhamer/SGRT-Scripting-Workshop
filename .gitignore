# Written by binder/start when the simulator runs from inside the repository.
maprt-sim.log

# The simulator's per-run state: the generated API token lives here. Never commit a token,
# even a throwaway one — it teaches the wrong habit.
.maprt_sim/

# Maintainer-only data overlay: real exported surfaces and recorded clearance maps. This is
# where patient-derived data goes so that it can never become a commit candidate. Everything
# the public repo needs is the synthetic data under data/ instead.
data/local/

