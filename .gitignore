# uv / Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Written by binder/start when the emulator runs from inside the repository.
maprt-emulator.log

# The emulator's per-run state: the generated API token lives here. Never commit a token,
# even a throwaway one — it teaches the wrong habit.
.maprt_emulator/

# Maintainer-only data overlays, one per product (data/MapRT/local/, and later
# data/AlignRT/local/ …): real exported surfaces and recorded clearance maps. This is where
# patient-derived data goes so that it can never become a commit candidate. Everything the
# public repo needs is the synthetic data beside each overlay instead.
data/*/local/

# Notebooks
.ipynb_checkpoints/
# The capstone notebook saves its report beside itself when it runs. Output, not source.
notebooks/*/plan_qa_report.png

# The working plan for this project. Kept on disk and useful, but it is a development log full
# of half-finished reasoning and next-step notes — not something a student cloning this should
# have to wade through.
WORKSHOP_PLAN.md

# OS
.DS_Store
